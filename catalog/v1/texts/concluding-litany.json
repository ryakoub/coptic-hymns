{
 "id": "concluding-litany",
 "titles": {
  "english": "The Concluding Litany",
  "coptic": "Ⲁ̀ⲙⲏⲛ Ⲕⲩⲣⲓⲉ ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ",
  "arabic": "طلبة الختام"
 },
 "lines": [
  {
   "id": "l1",
   "side": 0,
   "coptic": "-",
   "translations": {
    "english": "Kerie leysoun (Lord have mercy) is said three times before every part",
    "arabic": "يقال كيريي ليسون (يا رب إرحم) ثلاث مرات قبل كل ربع"
   },
   "transliterations": {
    "english": "-"
   }
  },
  {
   "id": "l2",
   "side": 1,
   "coptic": "Ⲁ̀ⲙⲏⲛ.",
   "translations": {
    "english": "Amen.",
    "arabic": "آمين."
   },
   "transliterations": {
    "english": "Ameen."
   }
  },
  {
   "id": "l3",
   "side": 0,
   "coptic": "Ⲕⲩⲣⲓⲉ ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ (ⲅ̅).",
   "translations": {
    "english": "Kerie leysoun (3).",
    "arabic": "كيريي ليسون (3)."
   },
   "transliterations": {
    "english": "Kirie ele-eeson (shomt)."
   },
   "sung": {
    "english": "Kereie leison, Kereie leison, Kereie leison (Lord Have Mercy)"
   }
  },
  {
   "id": "l4",
   "side": 1,
   "coptic": "Ⲫ̀ⲛⲟⲩϯ ⲛⲁⲓ ⲛⲁⲛ.",
   "translations": {
    "english": "O God have mercy on us.",
    "arabic": "يا الله إرحمنا."
   },
   "transliterations": {
    "english": "Efnoti nai nan."
   }
  },
  {
   "id": "l5",
   "side": 0,
   "coptic": "Ⲫ̀ⲛⲟⲩϯ ⲥⲱⲧⲉⲙ ⲉ̀ⲣⲟⲛ.",
   "translations": {
    "english": "O God hear us.",
    "arabic": "يا الله إسمعنا."
   },
   "transliterations": {
    "english": "Efnoti sotem eron."
   }
  },
  {
   "id": "l6",
   "side": 1,
   "coptic": "Ⲫ̀ⲛⲟⲩϯ ⲥⲟⲙⲥ ⲉ̀ⲣⲟⲛ.",
   "translations": {
    "english": "O God look to us.",
    "arabic": "يا الله أُنظر إلينا."
   },
   "transliterations": {
    "english": "Efnoti soms eron."
   },
   "sung": {
    "english": "O God behold us."
   }
  },
  {
   "id": "l7",
   "side": 0,
   "coptic": "Ⲫ̀ⲛⲟⲩϯ ϫⲟⲩϣⲧ ⲉ̀ⲣⲟⲛ.",
   "translations": {
    "english": "O God behold us.",
    "arabic": "يا الله إطَّلع علينا."
   },
   "transliterations": {
    "english": "Efnoti gousht eron."
   },
   "sung": {
    "english": "O God look to us."
   }
  },
  {
   "id": "l8",
   "side": 1,
   "coptic": "Ⲫ̀ⲛⲟⲩϯ ϣⲉⲛϩⲏⲧ ϧⲁⲣⲟⲩⲛ.",
   "translations": {
    "english": "O God have compassion on us.",
    "arabic": "يا الله تراءف علينا."
   },
   "transliterations": {
    "english": "Efnoti shenheet kharoun."
   }
  },
  {
   "id": "l9",
   "side": 0,
   "coptic": "Ⲁ̀ⲛⲟⲛ ϧⲁ ⲡⲉⲕⲗⲁⲟⲥ.",
   "translations": {
    "english": "We are Your people.",
    "arabic": "نحن شعبك."
   },
   "transliterations": {
    "english": "Anon kha peklaos."
   }
  },
  {
   "id": "l10",
   "side": 1,
   "coptic": "Ⲁ̀ⲛⲟⲛ ϧⲁ ⲡⲉⲕⲡ̀ⲗⲁⲥⲙⲁ.",
   "translations": {
    "english": "We are Your creation.",
    "arabic": "نحن جبلتك."
   },
   "transliterations": {
    "english": "Anon kha pekeplasma."
   }
  },
  {
   "id": "l11",
   "side": 0,
   "coptic": "Ⲛⲁϩⲙⲉⲛ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲛⲉⲛϫⲁϫⲓ.",
   "translations": {
    "english": "Deliver us from our enemies.",
    "arabic": "نجنا من أعدائنا."
   },
   "transliterations": {
    "english": "Nahmen evol khen nengaji."
   }
  },
  {
   "id": "l12",
   "side": 1,
   "coptic": "Ⲛⲁϩⲙⲉⲛ ⲉ̀ⲃⲟⲗ ϩⲁ ⲟⲩϩ̀ⲃⲱⲛ.",
   "translations": {
    "english": "Deliver us from inflation.",
    "arabic": "نجنا من الغلاء."
   },
   "transliterations": {
    "english": "Nahmen evol ha ou-ehvon."
   }
  },
  {
   "id": "l13",
   "side": 0,
   "coptic": "Ⲁ̀ⲛⲟⲛ ϧⲁ ⲛⲉⲕⲉ̀ⲃⲓⲁⲓⲕ.",
   "translations": {
    "english": "We are Your servants.",
    "arabic": "نحن عبيدك."
   },
   "transliterations": {
    "english": "Anon kha nekeviaik."
   }
  },
  {
   "id": "l14",
   "side": 1,
   "coptic": "Ⲩ̀ⲓⲟⲥ Ⲑⲉⲟⲥ ⲛ̀ⲑⲟⲕ.",
   "translations": {
    "english": "You are the Son of God.",
    "arabic": "أنت إبن الله."
   },
   "transliterations": {
    "english": "I-ios Theos enthok."
   }
  },
  {
   "id": "l15",
   "side": 0,
   "coptic": "Ⲁⲛⲛⲁϩϯ ⲉ̀ⲣⲟⲕ.",
   "translations": {
    "english": "We believe in You.",
    "arabic": "آمنا بك."
   },
   "transliterations": {
    "english": "Annahti erok."
   }
  },
  {
   "id": "l16",
   "side": 1,
   "coptic": "Ϫⲉ (ⲁⲕⲧⲱⲛⲕ/ⲁⲕⲓ̀) ⲁⲕⲥⲱϯ ⲙ̀ⲙⲟⲛ.",
   "translations": {
    "english": "For You have (risen/come) and saved us.",
    "arabic": "لأنك (قُمت/أتيت) وخلَّصتنا."
   },
   "transliterations": {
    "english": "Je (aktonk/aki) aksoti emmon."
   },
   "sung": {
    "english": "For You (have risen) and saved us."
   }
  },
  {
   "id": "l17",
   "side": 0,
   "coptic": "Ϫⲉⲙⲡⲉⲛϣⲓⲛⲓ ϧⲉⲛ ⲡⲉⲕⲟⲩϫⲁⲓ.",
   "translations": {
    "english": "Visit us with Your salvation.",
    "arabic": "تعهدنا بخلاصك."
   },
   "transliterations": {
    "english": "Jempenshini khen pekougai."
   }
  },
  {
   "id": "l18",
   "side": 1,
   "coptic": "Ⲟⲩⲟϩ ⲭⲁ ⲛⲉⲛⲛⲟⲃⲓ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ.",
   "translations": {
    "english": "And forgive us our sins.",
    "arabic": "وإغفر لنا خطايانا."
   },
   "transliterations": {
    "english": "O-woh ka nennovi nan evol."
   }
  },
  {
   "id": "l19",
   "side": 0,
   "coptic": "Ⲕⲩⲣⲓⲉ ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ.",
   "translations": {
    "english": "Kerie leysoun.",
    "arabic": "كيريي ليسون."
   },
   "transliterations": {
    "english": "Kirie ele-eeson."
   },
   "sung": {
    "english": "Kerie leison."
   }
  }
 ]
}